# ============================================
# APP DATABASE (Users, Auth, Sessions)
# ============================================
POSTGRES_SERVER=localhost
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=hr_analytics_db
POSTGRES_PORT=5432

# ============================================
# DWH DATABASE (Qlik Sense Datawarehouse)
# ============================================
# This is the separate datawarehouse database for analytics
# The query engine connects ONLY to this database, not to APP_DB
DWH_HOST=localhost
DWH_PORT=5432
DWH_DB=hr_datawarehouse
DWH_USER=hr_user
DWH_PASSWORD=your_password_here

# ============================================
# CLAUDE API (Query Engine NLP)
# ============================================
# Required for natural language query processing
# Get your API key from: https://console.anthropic.com/
# Model used: claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# GENERAL CONFIG
# ============================================
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PROJECT_NAME=Query HR Analytics Online
VERSION=1.0.0
API_V1_STR=/api/v1

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Qlik Sense
QLIK_SERVER=
QLIK_APP_ID=
